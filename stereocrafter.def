Bootstrap: localimage
From: stereocrafter-base.sif

%environment
    export DEBIAN_FRONTEND=noninteractive
    export PYTHONUNBUFFERED=1
    export PYTHONPATH=/app
    # Defaults when running inside the container (override with bind mounts or env).
    export VIDEO_DEPTH_CHECKPOINT=/app/dependency/Video-Depth-Anything/checkpoints/metric_video_depth_anything_vitl.pth

%files
    dependency/Video-Depth-Anything /app/dependency/Video-Depth-Anything
    depth_splatting_inference.py /app/depth_splatting_inference.py
    inpainting_inference.py /app/inpainting_inference.py
    run_inference.sh /app/run_inference.sh
    pipelines /app/pipelines
    frontend /app/frontend

%post
    pip install --no-cache-dir -r /app/frontend/requirements.txt

    mkdir -p /app/dependency/Video-Depth-Anything/checkpoints
    METRIC_URL="https://huggingface.co/depth-anything/Metric-Video-Depth-Anything-Large/resolve/main/metric_video_depth_anything_vitl.pth"
    METRIC_DST="/app/dependency/Video-Depth-Anything/checkpoints/metric_video_depth_anything_vitl.pth"
    # Skip download if already present (e.g. copied in via %files); -s rejects empty/partial files.
    if [ -f "${METRIC_DST}" ] && [ -s "${METRIC_DST}" ]; then
        echo "Metric Video Depth checkpoint already present at ${METRIC_DST}, skipping download."
    else
        echo "Downloading Metric Video Depth Anything (ViT-L) checkpoint..."
        wget -q --show-progress -O "${METRIC_DST}" "${METRIC_URL}" \
            || curl -fsSL -o "${METRIC_DST}" "${METRIC_URL}"
    fi

%runscript
    if [ $# -eq 0 ]; then
        exec sh /app/run_inference.sh
    else
        exec "$@"
    fi
