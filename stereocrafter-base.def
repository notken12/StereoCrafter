Bootstrap: docker
From: nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04

%environment
    export DEBIAN_FRONTEND=noninteractive
    export PYTHONUNBUFFERED=1

%post
    apt-get update && apt-get install -y --no-install-recommends \
        python3.10 \
        python3.10-dev \
        python3.10-distutils \
        python3-pip \
        git \
        git-lfs \
        ffmpeg \
        libgl1-mesa-glx \
        libglib2.0-0 \
        wget \
        ninja-build \
        && rm -rf /var/lib/apt/lists/*

    update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1

    export CUDA_HOME=/usr/local/cuda
    export PATH=$CUDA_HOME/bin:$PATH
    export LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
    export TORCH_CUDA_ARCH_LIST="7.0;7.5;8.0;8.6"

    python -m pip install --upgrade pip setuptools wheel

    mkdir -p /app
    cd /app

    # PyTorch from PyPI defaults to cu121; this image is CUDA 11.8. Match the toolkit
    # or Forward-Warp's torch.utils.cpp_extension build fails (CUDA version mismatch).
    pip install --no-cache-dir \
        torch==2.1.1 torchvision==0.16.1 xformers==0.0.23 \
        --index-url https://download.pytorch.org/whl/cu118

    pip install --no-cache-dir -r requirements.txt

    cd /app/dependency/Forward-Warp/Forward_Warp/cuda
    python setup.py install
    cd /app/dependency/Forward-Warp
    python setup.py install

    mkdir -p /app/outputs /app/source_video

%files
    requirements.txt /app/requirements.txt
    dependency/Forward-Warp /app/dependency/Forward-Warp
